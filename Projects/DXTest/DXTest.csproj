<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

	<Target Name="ChiselBuildContent" BeforeTargets="Build">
		<Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\..\Engine\Chisel.Resource.Builder&quot; -- &quot;$(MSBuildProjectDirectory)&quot; &quot;$(OutDir)Content&quot; --pack" />
	</Target>

	<ItemGroup>
	  <ProjectReference Include="..\..\Engine\Chisel.Framework\Chisel.Framework.csproj" />
	  <ProjectReference Include="..\..\Engine\Chisel.Resource.Builder\Chisel.Resource.Builder.csproj" />
	</ItemGroup>
</Project>
